# Copy to .env and fill in. Never commit .env.

# Vapi org for this hotel (dashboard > API Keys > Private Key)
VAPI_API_KEY=

# Twilio account that owns the hotel's number (on a verified A2P 10DLC campaign)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Beds24 (refresh token from an invite code, scoped to this property)
BEDS24_PROPERTY_ID=
BEDS24_REFRESH_TOKEN=

# Shared secret Vapi sends as x-vapi-secret to our server (generate a random string)
VAPI_SERVER_SECRET=
# Public base URL of hotel core (tunnel in dev)
PUBLIC_BASE_URL=

# Anthropic key for evals (judge + simulated agent)
ANTHROPIC_API_KEY=

# Supabase Postgres (session pooler URL; password URL-encoded)
SUPABASE_DB_PASSWORD=
DATABASE_URL=

# Supabase API (new-style keys; legacy anon/service_role retire 2027)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Key the dashboard (and Doss) send as x-dashboard-key to /api/* on hotel core
DASHBOARD_API_KEY=
DOSS_API_KEY=        # Doss's key for the core API (read + propose; never approve)
CORE_API_URL=        # where the Doss MCP reaches hotel core, e.g. http://127.0.0.1:8000
