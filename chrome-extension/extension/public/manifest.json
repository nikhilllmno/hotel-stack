{
  "manifest_version": 3,
  "name": "Hermes for Chrome",
  "version": "0.1.0",
  "description": "Chat with your Hermes agent in a side panel and let it work in your Chrome tabs.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": ["sidePanel", "debugger", "tabs", "tabGroups", "scripting", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Open Hermes" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
