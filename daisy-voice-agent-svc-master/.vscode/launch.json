{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug WebSocket Server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/websocket-server/src/server.ts",
      "cwd": "${workspaceFolder}/websocket-server",
      "runtimeArgs": [
        "-r", "dotenv/config",
        "-r", "ts-node/register"
      ],
      "env": {
        "NODE_ENV": "development",
        "DOTENV_CONFIG_PATH": "${workspaceFolder}/websocket-server/.env"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Attach to Process",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "localRoot": "${workspaceFolder}/websocket-server",
      "remoteRoot": "${workspaceFolder}/websocket-server",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}
  