{
  "name": "twilio-realtime",
  "version": "1.0.0",
  "description": "Twilio real-time server with TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "build": "rm -rf dist/ && tsc && cp -r src/static dist/static",
    "start": "NODE_ENV=production node dist/server.js",
    "dev": "NODE_ENV=development nodemon --watch 'src/**/*' --watch '.env' --ext 'ts,js,xml,env' --exec 'ts-node' src/server.ts",
    "test": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:all": "jest",
    "test:watch": "jest --selectProjects unit --watch",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "check:migrations": "node scripts/check-migration-numbers.js",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "cd .. && husky websocket-server/.husky || true"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.705.0",
    "@aws-sdk/client-ses": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.705.0",
    "@microsoft/agents-activity": "^1.9.1",
    "@microsoft/agents-hosting": "^1.9.1",
    "@types/knex": "^0.15.2",
    "@types/node": "^22.0.0",
    "@types/stripe": "^8.0.416",
    "@types/ws": "^8.5.12",
    "authorizenet": "^1.0.10",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "form-data": "^4.0.5",
    "geoip-lite": "^2.0.0",
    "httpdispatcher": "^2.2.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "lodash": "^4.18.0",
    "pg": "^8.16.0",
    "stripe": "^18.2.1",
    "to-words": "^4.7.0",
    "ts-node": "^10.9.2",
    "twilio": "^4.20.0",
    "typescript": "^5.5.4",
    "winston": "^3.17.0",
    "ws": "^8.18.0"
  },
  "overrides": {
    "axios": "$axios",
    "@microsoft/agents-hosting": {
      "@azure/msal-node": "^7.1.2",
      "zod": "^4.6.6"
    },
    "@microsoft/agents-activity": {
      "zod": "^4.6.6"
    }
  },
  "lint-staged": {
    "src/**/*.ts": "prettier --write",
    "src/migrations/**/*.ts": "node scripts/check-migration-numbers.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@testcontainers/postgresql": "^12.0.1",
    "@types/authorizenet": "^1.0.3",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^5.0.0",
    "@types/geoip-lite": "^1.4.4",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.18",
    "@typescript-eslint/eslint-plugin": "^8.34.0",
    "@typescript-eslint/parser": "^8.34.0",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jiti": "^2.5.1",
    "lint-staged": "^15.5.2",
    "nock": "^14.0.17",
    "nodemon": "^3.1.10",
    "pg-mem": "^3.0.5",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "testcontainers": "^12.0.1",
    "ts-jest": "^29.2.5",
    "typescript-eslint": "^8.38.0"
  }
}
