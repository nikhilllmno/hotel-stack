# the table is the source of truth.
ESCALATION_AGENT_URL_CONFIG={}
# DEPRECATED / TRANSITIONAL: transcript agent URLs now live on
# hotel_configurations.transcript_agent_url. Kept only so the backfill migration
# (139_migrate_transcript_agent_url_to_db) can seed the table. Safe to remove once
# the table is the source of truth.
TRANSCRIPT_AGENT_URL_CONFIG={}
# Shared support ops handback webhook (plain URL, all hotels). Used when a manager
# clicks "Switch to AI" in Telegram — POST { from, to, body }. Replaces the
# former per-hotel HANDBACK_AGENT_URL_CONFIG JSON map.
HANDBACK_AGENT_URL=

# Vapi
VAPI_ASSISTANT_SERVER_TOKEN=
VAPI_API_KEY=
VAPI_OLD_API_KEY=                  # Required in non-prod for recording backfill APIs

# vapi structured output IDs
VAPI_FOLLOWUP_AVAILABILITY_STRUCTURED_OUTPUT_ID=

# JWT: set DAISY_JWT_PRIVATE_KEY_PEM for RS256 + JWKS (issuer daisy-voice-agent-svc, audience dextr-deepagent).
# Otherwise HS256 with JWT_SECRET (legacy).
JWT_SECRET=
DAISY_JWT_PRIVATE_KEY_PEM=
DAISY_JWT_KID=
JWT_ISS=
JWT_AUDIENCE=

#aws
AWS_REGION=
S3_BUCKET=

# Email (AWS SES)
SES_FROM_EMAIL=                   # Verified sender email address in SES (e.g. noreply@example.com)
SES_REGION=                       # SES region (defaults to AWS_REGION if empty)

# Alfred
ALFRED_API_BASE_URL=
ALFRED_API_KEY=

# Support-ops
SUPPORT_OPS_API_KEY=

# Outbound token Daisy sends to the transcript agent. Not used for inbound auth.
DAISY_API_KEY_V2=
# Inbound x-api-key auth, comma-separated. Expired keys are accepted with a warning.
DAISY_INBOUND_API_KEYS=
DAISY_INBOUND_API_KEYS_EXPIRED=

ESCALATION_INSTRUCTION_CONFIG={"hotel_id_1": {"start":"18:00","end":"07:30","within_hours":"Since this issue needs more attention, forward the call to the manager also take a callback message.","outside_hours":"Escalate the issue to manager as a callback message."}}

DEFAULT_CHECK_IN_TIME=15:00
DEFAULT_CHECK_OUT_TIME=11:00

BOOKING_REVIEW_ID_MAX_RETRIES=10
PAYMENT_LINK_ID_MAX_RETRIES=10

AUTHORIZE_NET_VERIFY_API_LOGIN_ID=
AUTHORIZE_NET_VERIFY_TRANSACTION_KEY=
