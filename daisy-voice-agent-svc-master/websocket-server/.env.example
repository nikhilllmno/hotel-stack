HOSTAWAY_PROVIDER_ID=

#Stayntouch
STAYNTOUCH_BASE_URL=
STAYNTOUCH_AUTH_URL=
ENCRYPTION_SECRET=


# Cloudbeds
CLOUDBEDS_BASE_URL=
CLOUDBEDS_SDK_ENV=stage
# Base URL for the Cloudbeds Payments SDK key-issuance API
CLOUDBEDS_SDK_API_BASE_URL=
# Uniquely identifies our marketplace app to Cloudbeds; used to filter
# integration/appstate_changed webhooks down to events about our own app
CLOUDBEDS_CLIENT_ID=
# false = createReservation always sends paymentMethod=cash (pre-Stripe-card-token behavior)
# true  = sends the Stripe cardToken/paymentAuthorizationCode and paymentMethod=credit when available
CLOUDBEDS_CARD_TOKEN_ENABLED=
# Slack user IDs (comma-separated) to @-mention on the critical integration/appstate_changed
# "disabled" Slack alert
DEXTR_SLACK_ALERT_MENTION_USER_IDS=
# Dedicated incoming webhook URL for that same alert
DEXTR_SLACK_WEBHOOK_URL=

# Calry — unified gateway API fronting Oracle Opera and other PMSes
CALRY_BASE_URL=
# Dextr's Calry workspace, sent as the workspaceId header on every unified call.
# Global: each hotel is a separate integration account inside this one workspace.
CALRY_WORKSPACE_ID=
# Opera Cloud target for Calry passthrough calls (Calry has no unified
# availability endpoint for Opera/OHIP).
OPERA_HOST=
# Opera property code sent as x-hotelid — not the Calry propertyId.
OPERA_HOTEL_ID=
# Opera x-app-key. Leave empty if Calry injects it on passthrough.
OPERA_APP_KEY=
# Rate plans tried per room type when a hotel has no rate_code_config
# (two Opera calls each). Defaults to 5.
OPERA_MAX_RATE_PLAN_CANDIDATES=
# RemoteLock
REMOTELOCK_API_URL=
REMOTELOCK_AUTH_URL=
# Dextr's OAuth Application credentials — one pair for all hotels
REMOTELOCK_CLIENT_ID=
REMOTELOCK_CLIENT_SECRET=
# Must match the Redirect URI registered on that Application
REMOTELOCK_OAUTH_REDIRECT_URI=
# Dropbox: Dextr's read-only app on Dextr's Dropbox account, used to read
# lockbox logs hotels share with it. Refresh token from the offline code flow.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

LOG_LEVEL=

# Test lines (comma-separated). Phone reservation lookups return at most TEST_RESERVATION_LIMIT rows for these numbers.
TEST_NUMBERS=14083205093,14084048097

PAYMENT_TIMEOUT=
PAYMENT_AGE_THRESHOLD=
PAYMENT_REMINDER_NOTIFICATION_LIMIT=
API_TIMEOUT=
PMS_BOOKING_CLAIM_TTL_MINUTES=5

#stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECTED_ACCOUNT_WEBHOOK_SECRET=
